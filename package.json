{
  "name": "@deepseek-ai/dsh-win-desktop",
  "description": "Windows Desktop integration plugin: exposes the DSH Windows desktop bridge via HTTP and a React UI panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-win-desktop": "bin/dsh-win-desktop.bat"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "bin",
    "scripts",
    "src/host",
    "src/client",
    "README.md",
    "LICENSE",
    "cordis.patch.yml",
    "dsh-plugin.json"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.12.0",
    "@deepseek-ai/dsh-invariants": ">=0.12.0",
    "@deepseek-ai/schemastery": ">=0.12.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=0.12.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=0.12.0",
    "@deepseek-ai/dsh-invariants": ">=0.12.0",
    "@deepseek-ai/schemastery": ">=0.12.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.12.0",
    "@deepseek-ai/dsh-client-locale": ">=0.12.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.12.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.12.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "typescript": "^5.4.0"
  },
  "scripts": {
    "build": "node scripts/prebuild.js",
    "prepare": "node scripts/prebuild.js",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "start": "node scripts/standalone-dsh.js start",
    "status": "node scripts/standalone-dsh.js status",
    "install": "node scripts/standalone-dsh.js install",
    "stop": "node scripts/standalone-dsh.js stop",
    "doctor": "node scripts/standalone-dsh.js doctor",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
